<?php

/**
 * @file
 * Primary module hooks for Neo module.
 *
 * Nothing in this file is a hook implementation. Every one of them is a method
 * on a class under `src/Hook` — \Drupal\neo\Hook\NeoHooks for the behavioural
 * hooks, \Drupal\neo\Hook\NeoThemeHooks for theme registration, the suggestion
 * and the preprocessors, and \Drupal\neo\Hook\FormAlterHook for the form alter.
 *
 * What is left is three globals that are deliberately global. The table props
 * shim is called from another repository and is deprecated in its docblock;
 * `ksm()` and `kint()` are pinned here by the packages' own pre-commit hook,
 * which exempts `neo.module` by path from its debug-call check and would
 * therefore refuse to commit any file under `src/` that carried them.
 */

declare(strict_types=1);

use Drupal\devel\Render\FilteredMarkup;
use Drupal\neo\Helpers\TableProps;
use Kint\Kint;

/**
 * Get table props.
 *
 * @return array
 *   The table props.
 *
 * @deprecated in neo:1.1.0 and is removed from neo:2.0.0. Use
 *   \Drupal\neo\Helpers\TableProps::get() instead.
 *
 * @see \Drupal\neo\Helpers\TableProps::get()
 */
function neo_table_props(): array {
  return TableProps::get();
}

/**
 * Backwards support for old habbits.
 */
if (!function_exists('ksm') && class_exists('Kint')) {

  /**
   * Prints passed argument(s) to the 'message' area of the page.
   *
   * Wrapper for DevelDumperManager::message().
   *
   * @see \Drupal\devel\DevelDumperManager::message()
   */
  // phpcs:ignore Drupal.NamingConventions.ValidFunctionName.InvalidPrefix
  function ksm(mixed ...$args): void {
    ob_start();
    call_user_func_array(['Kint', 'dump'], $args);
    $dump = ob_get_clean();
    \Drupal::messenger()->addMessage(FilteredMarkup::create($dump), 'status', TRUE);
  }

  Kint::$aliases[] = 'ksm';

}

/**
 * Backwards support for old habbits.
 */
if (!function_exists('kint') && class_exists('Kint')) {

  /**
   * Prints passed argument(s) to the 'message' area of the page.
   *
   * Wrapper for DevelDumperManager::message().
   *
   * @see \Drupal\devel\DevelDumperManager::message()
   */
  // phpcs:ignore Drupal.NamingConventions.ValidFunctionName.InvalidPrefix
  function kint(mixed ...$args): void {
    ob_start();
    Kint::dump(...$args);
  }

  Kint::$aliases[] = 'kint';

}
